---
interface Props {
  showPortfolioLink?: boolean;
}

const { showPortfolioLink = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="shell flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 font-mono text-[10px] uppercase tracking-[0.05em] text-muted">
  <span>&copy; {year} Thomas Mohr</span>
  <div class="order-3 flex w-full justify-between gap-4 md:order-none md:w-auto md:gap-6">
    {
      showPortfolioLink ? (
        <a class="hover:text-ink" href="/">
          Portfolio
        </a>
      ) : (
        <a class="hover:text-ink" href="https://github.com/Thames1990" target="_blank" rel="noopener">
          GitHub
        </a>
      )
    }
    <a class="hover:text-ink" href="mailto:thomasmohr1990@gmail.com">Email</a>
    {!showPortfolioLink && <a class="hover:text-ink" href="/cv">CV</a>}
  </div>
  <span class="text-ink">TM / 90</span>
</footer>
