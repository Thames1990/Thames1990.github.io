---
import { cv } from '@/data/cv';

interface Props {
  showPortfolioLink?: boolean;
}

const { showPortfolioLink = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer shell flex flex-wrap items-center justify-between gap-4 py-6 text-sm text-muted-foreground">
  <span>&copy; {year} Thomas Mohr</span>
  <div class="order-3 flex w-full justify-between gap-4 md:order-0 md:w-auto md:gap-6">
    {
      showPortfolioLink ? (
        <a class="hover:text-brand" href="/">
          Portfolio
        </a>
      ) : (
        <a class="hover:text-brand" href={cv.github} target="_blank" rel="noopener">
          GitHub
        </a>
      )
    }
    <a class="hover:text-brand" href={`mailto:${cv.email}`}>Email</a>
  </div>
</footer>
