---
import { buttonVariants } from '@/components/ui/button';
import { HeaderNavigation } from '@/components/HeaderNavigation';
import { ThemePreference } from '@/components/ThemePreference';

interface Props {
  cvHref?: string;
  cvLabel?: string;
}

const { cvHref = '/cv', cvLabel = 'Open CV' } = Astro.props;
---

<header class="sticky top-0 z-40 border-b bg-background">
  <div class="shell flex h-16 items-center justify-between gap-3">
    <a class="flex shrink-0 items-center gap-2 text-sm font-medium" href="/" aria-label="TM / 90 — Thomas Mohr home">
      <span class="grid size-8 place-items-center rounded-md bg-primary text-xs text-primary-foreground">TM</span>
      <span class="hidden sm:inline">/ 90</span>
    </a>
    <div class="flex items-center gap-2">
      <HeaderNavigation client:load />
      <ThemePreference client:load />
      <a id="cv-action" class={buttonVariants()} href={cvHref} aria-label={cvLabel}>
        {cvLabel === 'Back to portfolio' ? (
          <><span class="sm:hidden">Back</span><span class="hidden sm:inline">{cvLabel}</span></>
        ) : cvLabel}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
