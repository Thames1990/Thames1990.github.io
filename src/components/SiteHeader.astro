---
interface Props {
  cvHref?: string;
  cvLabel?: string;
}

const { cvHref = '/cv', cvLabel = 'Open CV' } = Astro.props;
const isCvAction = cvHref === '/cv';
---

<header class="absolute left-0 top-0 z-[5] w-full text-ink">
  <nav class="shell flex h-[76px] items-center justify-between border-b border-line/80 md:h-[94px]" aria-label="Main navigation">
    <a class="flex items-center font-mono text-sm tracking-[0.05em]" href="/" aria-label="Thomas Mohr home" transition:name="site-logo">
      <span class="mr-2 grid h-9 w-9 place-items-center rounded-full bg-ink text-[11px] text-paper shadow-[0_10px_24px_-6px_rgb(var(--color-accent)/0.55)]">TM</span> / 90
    </a>
    <div class="flex items-center gap-3 md:gap-7">
      <button
        id="menu-toggle"
        class="menu-toggle relative order-2 grid h-11 w-11 place-items-center rounded-full text-ink md:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="relative block h-[14px] w-[22px]">
          <i class="menu-bar menu-bar-top absolute inset-x-0 top-0 block h-[1.5px] rounded-full bg-current"></i>
          <i class="menu-bar menu-bar-bottom absolute inset-x-0 bottom-0 block h-[1.5px] rounded-full bg-current"></i>
        </span>
      </button>
      <div
        id="site-menu"
        class="site-menu absolute left-5 right-5 top-[68px] z-40 flex-col items-stretch gap-0 overflow-hidden rounded-2xl border border-line bg-panel text-ink shadow-[0_2px_0_0_rgb(var(--color-line)/0.9),0_28px_60px_-24px_rgb(var(--color-veil)/0.55)] backdrop-blur-xl md:static md:top-auto md:z-auto md:order-1 md:flex md:w-auto md:flex-row md:items-center md:gap-7 md:overflow-visible md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none md:backdrop-blur-none"
      >
        <nav class="flex flex-col md:contents" aria-label="Section links">
          <a class="site-menu-link group flex items-center justify-between gap-4 border-b border-line px-5 py-4 text-sm font-bold text-ink md:border-0 md:p-0 md:text-xs md:text-muted md:hover:text-ink" href="/#work">
            <span class="flex items-center gap-3">
              <span class="font-mono text-[10px] text-muted transition-colors duration-300 group-hover:text-accent md:hidden">01</span>
              Impact
            </span>
            <span aria-hidden="true" class="text-muted transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent md:hidden">↗</span>
          </a>
          <a class="site-menu-link group flex items-center justify-between gap-4 border-b border-line px-5 py-4 text-sm font-bold text-ink md:border-0 md:p-0 md:text-xs md:text-muted md:hover:text-ink" href="/#experience">
            <span class="flex items-center gap-3">
              <span class="font-mono text-[10px] text-muted transition-colors duration-300 group-hover:text-accent md:hidden">02</span>
              Experience
            </span>
            <span aria-hidden="true" class="text-muted transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent md:hidden">↗</span>
          </a>
          <a class="site-menu-link group flex items-center justify-between gap-4 px-5 py-4 text-sm font-bold text-ink md:border-0 md:p-0 md:text-xs md:text-muted md:hover:text-ink" href="/#contact">
            <span class="flex items-center gap-3">
              <span class="font-mono text-[10px] text-muted transition-colors duration-300 group-hover:text-accent md:hidden">03</span>
              Contact
            </span>
            <span aria-hidden="true" class="text-muted transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent md:hidden">↗</span>
          </a>
        </nav>
        <div class="site-menu-theme border-t border-line px-5 py-4 md:border-0 md:p-0">
          <span class="mb-2 block font-mono text-[10px] uppercase tracking-[0.14em] text-muted md:hidden">Appearance</span>
          <div class="flex rounded-full border border-line p-1 font-mono text-[10px] uppercase tracking-[0.08em]" aria-label="Theme preference">
            <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="system" aria-pressed="true">System</button>
            <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="light" aria-pressed="false">Light</button>
            <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
          </div>
        </div>
      </div>
      <script is:inline>
        // Sync the toggle's pressed state immediately, before the deferred
        // header script runs, so it never visibly flashes on "System" first.
        (() => {
          try {
            const stored = localStorage.getItem('theme');
            const theme = stored === 'light' || stored === 'dark' ? stored : 'system';
            document.querySelectorAll('[data-theme-choice]').forEach((choice) => {
              choice.setAttribute('aria-pressed', String(choice.getAttribute('data-theme-choice') === theme));
            });
          } catch {
            // Leave the server-rendered "System" state as the fallback.
          }
        })();
      </script>
      <a
        id="cv-action"
        class="cv-action order-1 md:order-2"
        href={cvHref}
        aria-label={cvLabel}
        data-floating-cv-action={isCvAction ? 'true' : undefined}
      >
        <span>{cvLabel}</span><span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>

<script>
  function initHeader() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('site-menu');
    const choices = document.querySelectorAll('[data-theme-choice]');
    const floatingCvAction = document.querySelector('[data-floating-cv-action="true"]');

    // `astro:page-load` fires on the initial page load as well as every
    // subsequent view-transition navigation, so this function can run twice
    // for the same header markup. Guard against double-binding listeners,
    // which previously made the mobile menu toggle appear unresponsive (two
    // click handlers toggled it open, then immediately closed it again).
    if (toggle?.dataset.headerBound === 'true') {
      return;
    }
    if (toggle) {
      toggle.dataset.headerBound = 'true';
    }

    /** @returns {'system' | 'light' | 'dark'} */
    const getStoredTheme = () => {
      try {
        const theme = localStorage.getItem('theme');
        return theme === 'light' || theme === 'dark' ? theme : 'system';
      } catch {
        return 'system';
      }
    };

    const syncPressedThemeChoice = () => {
      const theme = getStoredTheme();
      choices.forEach((choice) => {
        choice.setAttribute('aria-pressed', String(choice.getAttribute('data-theme-choice') === theme));
      });
    };

    const applyStoredTheme = () => {
      const theme = getStoredTheme();

      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      syncPressedThemeChoice();
    };

    applyStoredTheme();

    choices.forEach((choice) => {
      choice.addEventListener('click', () => {
        const theme = choice.getAttribute('data-theme-choice');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            // The selected visual theme can still apply for this page view.
          }
        } else if (theme === 'system') {
          document.documentElement.removeAttribute('data-theme');
          try {
            localStorage.removeItem('theme');
          } catch {
            // System mode still works without persistence.
          }
        }

        syncPressedThemeChoice();
      });
    });

    if (toggle && menu) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('is-open', open);
      };

      toggle.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (
          toggle.getAttribute('aria-expanded') === 'true' &&
          target instanceof Node &&
          !menu.contains(target) &&
          !toggle.contains(target)
        ) {
          setOpen(false);
        }
      });
    }

    if (floatingCvAction) {
      const syncCvActionPosition = () => {
        floatingCvAction.classList.toggle('is-floating', window.scrollY > 140);
      };

      syncCvActionPosition();
      window.addEventListener('scroll', syncCvActionPosition, { passive: true });
    }
  }

  // Astro View Transitions swap in a fresh header on every navigation, so
  // re-run setup each time instead of relying on the script executing once.
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
