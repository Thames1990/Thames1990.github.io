---
interface Props {
  cvHref?: string;
  cvLabel?: string;
}

const { cvHref = '/cv', cvLabel = 'Open CV' } = Astro.props;
const isCvAction = cvHref === '/cv';
---

<header class="absolute left-0 top-0 z-[5] w-full text-ink">
  <nav class="shell flex h-[76px] items-center justify-between border-b border-line/80 md:h-[94px]" aria-label="Main navigation">
    <a class="flex items-center font-mono text-sm tracking-[0.05em]" href="/" aria-label="Thomas Mohr home" transition:name="site-logo">
      <span class="mr-2 grid h-9 w-9 place-items-center rounded-full bg-ink text-[11px] text-paper shadow-[0_10px_24px_-6px_rgb(var(--color-accent)/0.55)]">TM</span> / 90
    </a>
    <div class="flex items-center gap-3 md:gap-7">
      <button
        id="menu-toggle"
        class="order-2 flex flex-col gap-[5px] border-0 bg-transparent p-2 md:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="sr-only">Toggle navigation</span>
        <i class="block h-px w-[22px] bg-ink"></i>
        <i class="block h-px w-[22px] bg-ink"></i>
      </button>
      <div
        id="site-menu"
        class="absolute left-5 right-5 top-[76px] hidden flex-col items-stretch gap-0 border border-line bg-panel px-5 py-4 text-ink shadow-[0_24px_48px_-16px_rgb(var(--color-veil)/0.5)] backdrop-blur-xl md:static md:order-1 md:flex md:w-auto md:flex-row md:items-center md:gap-7 md:border-0 md:bg-transparent md:p-0 md:shadow-none md:backdrop-blur-none"
      >
        <a class="px-0 py-3.5 text-xs font-bold text-muted hover:text-ink" href="/#work">Impact</a>
        <a class="px-0 py-3.5 text-xs font-bold text-muted hover:text-ink" href="/#experience">Experience</a>
        <a class="px-0 py-3.5 text-xs font-bold text-muted hover:text-ink" href="/#contact">Contact</a>
        <div class="my-2 flex rounded-full border border-line p-1 font-mono text-[10px] uppercase tracking-[0.08em] md:my-0" aria-label="Theme preference">
          <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="system" aria-pressed="true">System</button>
          <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="light" aria-pressed="false">Light</button>
          <button class="theme-choice rounded-full px-3 py-2 text-muted transition-colors hover:text-ink" type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
        </div>
      </div>
      <a
        id="cv-action"
        class="cv-action order-1 md:order-2"
        href={cvHref}
        aria-label={cvLabel}
        data-floating-cv-action={isCvAction ? 'true' : undefined}
      >
        <span>{cvLabel}</span><span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>

<script>
  function initHeader() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('site-menu');
    const choices = document.querySelectorAll('[data-theme-choice]');
    const floatingCvAction = document.querySelector('[data-floating-cv-action="true"]');

    /** @returns {'system' | 'light' | 'dark'} */
    const getStoredTheme = () => {
      try {
        const theme = localStorage.getItem('theme');
        return theme === 'light' || theme === 'dark' ? theme : 'system';
      } catch {
        return 'system';
      }
    };

    const syncPressedThemeChoice = () => {
      const theme = getStoredTheme();
      choices.forEach((choice) => {
        choice.setAttribute('aria-pressed', String(choice.getAttribute('data-theme-choice') === theme));
      });
    };

    const applyStoredTheme = () => {
      const theme = getStoredTheme();

      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      syncPressedThemeChoice();
    };

    applyStoredTheme();

    choices.forEach((choice) => {
      choice.addEventListener('click', () => {
        const theme = choice.getAttribute('data-theme-choice');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            // The selected visual theme can still apply for this page view.
          }
        } else if (theme === 'system') {
          document.documentElement.removeAttribute('data-theme');
          try {
            localStorage.removeItem('theme');
          } catch {
            // System mode still works without persistence.
          }
        }

        syncPressedThemeChoice();
      });
    });

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        menu.classList.toggle('hidden', isOpen);
        menu.classList.toggle('flex', !isOpen);
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.add('hidden');
          menu.classList.remove('flex');
        });
      });
    }

    if (floatingCvAction) {
      const syncCvActionPosition = () => {
        floatingCvAction.classList.toggle('is-floating', window.scrollY > 140);
      };

      syncCvActionPosition();
      window.addEventListener('scroll', syncCvActionPosition, { passive: true });
    }
  }

  // Astro View Transitions swap in a fresh header on every navigation, so
  // re-run setup each time instead of relying on the script executing once.
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
