---
import { getEntry, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

const cvEntry = await getEntry('cv', 'cv');
if (!cvEntry) {
  throw new Error('CV content entry "cv" is missing from src/content/cv/cv.md');
}

const cv = cvEntry.data;
const { Content } = await render(cvEntry);
---

<Layout title={`CV — ${cv.name}`} description={`Curriculum vitae for ${cv.name}, ${cv.title}.`}>
  <SiteHeader cvHref="/" cvLabel="Back to portfolio" />

  <main class="shell pb-20 pt-[125px] md:pb-24 md:pt-[150px]">
    <div class="mb-10 flex flex-col border-b border-line pb-10 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Curriculum vitae · generated from cv.md</p>
        <h1 class="m-0 text-[clamp(46px,7vw,90px)] leading-[0.9] tracking-[-0.08em]">
          {cv.name.split(' ')[0]}{' '}
          <em class="font-serif font-normal not-italic">{cv.name.split(' ').slice(1).join(' ')}.</em>
        </h1>
      </div>
      <div class="mt-8 flex items-center gap-[10px] md:mt-0">
        <button
          id="print-cv"
          type="button"
          class="border border-ink px-[14px] py-[11px] font-mono text-[11px] hover:bg-ink hover:text-paper"
          >Print / save PDF</button
        >
        <a
          href="/files/CV.pdf"
          download
          class="border border-ink px-[14px] py-[11px] font-mono text-[11px] hover:bg-ink hover:text-paper"
          >Original PDF ↗</a
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_2fr] md:gap-[100px]">
      <aside class="text-sm">
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Contact</h2>
          <p class="text-muted">
            {cv.location}<br />{cv.email}<br />{cv.github}
          </p>
        </section>
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Focus</h2>
          <ul class="list-none space-y-1.5 p-0 text-muted">
            {cv.focus.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Tools</h2>
          <p class="text-muted">{cv.tools.join(' · ')}</p>
        </section>
        <p class="mt-9 bg-[#e2dfd6] p-[15px] font-mono text-[10px] leading-relaxed text-muted">
          This CV is generated at build time from <code>src/content/cv/cv.md</code>. Edit that file and rebuild to
          update it — there's no in-browser editing or local storage involved anymore.
        </p>
      </aside>

      <div>
        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Profile</h2>
          <div class="prose prose-sm max-w-none text-muted prose-p:my-3">
            <Content />
          </div>
        </section>

        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Experience</h2>
          {
            cv.experience.map((role) => (
              <div class="mb-9 grid grid-cols-1 gap-1 md:grid-cols-[145px_1fr] md:gap-[25px]">
                <div class="font-mono text-[11px] uppercase text-accent">{role.date}</div>
                <div>
                  <h3 class="m-0 text-2xl tracking-[-0.04em]">{role.title}</h3>
                  <p class="text-sm text-muted">
                    {role.place}
                    <br />
                    {role.description}
                  </p>
                </div>
              </div>
            ))
          }
        </section>

        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Education</h2>
          {
            cv.education.map((entry) => (
              <div class="mb-9 grid grid-cols-1 gap-1 md:grid-cols-[145px_1fr] md:gap-[25px] last:mb-0">
                <div class="font-mono text-[11px] uppercase text-accent">{entry.date}</div>
                <div>
                  <h3 class="m-0 text-2xl tracking-[-0.04em]">{entry.title}</h3>
                  <p class="text-sm text-muted">
                    {entry.place}
                    <br />
                    {entry.description}
                  </p>
                </div>
              </div>
            ))
          }
        </section>
      </div>
    </div>
  </main>

  <SiteFooter showPortfolioLink />
</Layout>

<style>
  @media print {
    header,
    #print-cv,
    footer {
      display: none !important;
    }
  }
</style>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => {
    window.print();
  });
</script>
