---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { Button } from '@/components/ui/button';
import { Alert, AlertTitle } from '@/components/ui/alert';
import { cv } from '@/data/cv';

const cvPdfFilename = `${cv.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-cv.pdf`;
---

<Layout title={`CV — ${cv.name}`} description={`Curriculum vitae for ${cv.name}, ${cv.title}.`}>
  <SiteHeader cvHref="/" cvLabel="Back to portfolio" />

  <main id="main" tabindex="-1" class="shell pb-20 pt-10 md:pb-24 md:pt-14">
    <div class="mb-10 flex flex-col border-b border-line pb-10 md:mb-16 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <h1 class="m-0 text-[clamp(44px,6vw,64px)] font-semibold leading-[1.05] tracking-[-0.045em]">
          {cv.name.split(' ')[0]}{' '}
          <em class="tracking-[-0.02em]">{cv.name.split(' ').slice(1).join(' ')}.</em>
        </h1>
        <p class="mb-0 mt-4 text-lg font-medium text-muted-foreground">{cv.title}</p>
      </div>
      <div class="mt-8 w-full md:mt-0 md:w-auto">
        <Button
        id="download-cv"
        type="button"
        data-magnetic
        data-magnetic-strength="10"
        data-cv-pdf-filename={cvPdfFilename}
        size="lg"
        className="download-cv-button group w-full md:w-auto"
      >
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" data-download-icon viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2v10m0 0 4-4m-4 4L6 8M3 15.5V18h14v-2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="hidden h-4 w-4 animate-spin" data-loading-icon viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-opacity=".25" stroke-width="2"></circle>
            <path d="M17 10a7 7 0 0 0-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span data-download-label>Download PDF</span>
        </Button>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(220px,0.8fr)_minmax(0,2.2fr)] md:gap-[72px]">
      <aside class="text-sm">
        <section class="cv-block pb-9">
          <h2 class="section-label">Availability</h2>
          <Alert role="note">
            <AlertTitle>{cv.availability}</AlertTitle>
          </Alert>
        </section>

        <section class="cv-block pb-9">
          <h2 class="section-label">Contact</h2>
          <address class="space-y-1.5 not-italic text-muted-foreground">
            <p>{cv.location}</p>
            <p><a class="cv-link" href={`mailto:${cv.email}`}>{cv.email}</a></p>
            <p><a class="cv-link" href={cv.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
            <p><a class="cv-link" href={cv.github} target="_blank" rel="noopener">GitHub</a></p>
          </address>
        </section>

        <section class="cv-block pb-9">
          <h2 class="section-label">Languages</h2>
          <dl class="space-y-3">
            {cv.languages.map((language) => (
              <div>
                <dt class="font-semibold text-ink">{language.name}</dt>
                <dd class="text-xs text-muted-foreground">{language.level}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="cv-block pb-9">
          <h2 class="section-label">Core strengths</h2>
          <ul class="space-y-1.5 text-muted-foreground">
            {cv.competencies.map((competency) => <li>{competency}</li>)}
          </ul>
        </section>

        {cv.skillGroups.map((group) => (
          <section class="cv-block pb-9">
            <h2 class="section-label">{group.category}</h2>
            <p class="leading-relaxed text-muted-foreground">{group.skills.join(' · ')}</p>
          </section>
        ))}
      </aside>

      <div>
        <section class="cv-block mb-14">
          <h2 class="section-label">Profile</h2>
          <div id="cv-profile" class="prose prose-sm max-w-none text-muted-foreground prose-p:my-3 prose-p:leading-relaxed">
            {cv.profile.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="mb-14">
          <h2 class="section-label">Experience</h2>
          {cv.experience.map((role) => (
            <article class="experience-entry grid grid-cols-1 gap-2 border-b border-line py-9 first:pt-2 last:border-0 md:grid-cols-[130px_1fr] md:gap-7" data-reveal>
              <div>
                <p class="m-0 text-sm font-medium leading-relaxed text-brand">{role.date}</p>
              </div>
              <div>
                <h3 class="m-0 text-[22px] leading-tight tracking-[-0.04em]">{role.title}</h3>
                <p class="mb-1 mt-2 text-sm font-semibold text-ink">{role.company}</p>
                <p class="m-0 text-xs leading-relaxed text-muted-foreground">
                  {role.location} · {role.arrangement}
                </p>
                <p class="mb-4 mt-5 text-sm leading-relaxed text-muted-foreground">{role.summary}</p>
                <ul class="ml-4 list-disc space-y-2 text-sm leading-relaxed text-muted-foreground marker:text-brand">
                  {role.highlights.map((highlight) => <li class="pl-1">{highlight}</li>)}
                </ul>
                {role.links.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[10px] uppercase">
                    {role.links.map((link) => (
                      <a class="cv-link" href={link.url} target="_blank" rel="noopener">{link.label} ↗</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </section>

        <section class="mb-14">
          <h2 class="section-label">Education</h2>
          {cv.education.map((entry) => (
            <article class="education-entry grid grid-cols-1 gap-2 border-b border-line py-7 first:pt-2 last:border-0 md:grid-cols-[130px_1fr] md:gap-7" data-reveal>
              <p class="m-0 text-sm font-medium text-brand">{entry.date}</p>
              <div>
                <h3 class="m-0 text-xl tracking-[-0.04em]">{entry.title}</h3>
                <p class="mb-1 mt-2 text-sm font-semibold text-ink">{entry.place}</p>
                <p class="my-2 text-sm leading-relaxed text-muted-foreground">{entry.description}</p>
                {entry.highlights.length > 0 && (
                  <ul class="ml-4 list-disc space-y-1 text-sm leading-relaxed text-muted-foreground marker:text-brand">
                    {entry.highlights.map((highlight) => <li class="pl-1">{highlight}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </section>
      </div>
    </div>
  </main>

  <SiteFooter showPortfolioLink />
</Layout>

<style>
  .section-label {
    margin: 0 0 1.125rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .cv-link {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .cv-link:hover {
    color: var(--brand);
    text-decoration-color: var(--brand);
  }

  @media print {
    @page {
      margin: 14mm;
      size: A4;
    }

    header,
    #download-cv,
    footer {
      display: none !important;
    }

    main {
      width: 100% !important;
      max-width: none !important;
      padding: 0 !important;
    }

    .experience-entry,
    .education-entry,
    .cv-block {
      break-inside: avoid;
    }

    a {
      color: inherit !important;
      text-decoration: none !important;
    }
  }
</style>

<script>
  const button = document.getElementById('download-cv');
  const label = button?.querySelector('[data-download-label]');
  const downloadIcon = button?.querySelector('[data-download-icon]');
  const loadingIcon = button?.querySelector('[data-loading-icon]');

  button?.addEventListener('click', async () => {
    if (!(button instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) {
      return;
    }

    button.disabled = true;
    label.textContent = 'Preparing your PDF…';
    downloadIcon?.classList.add('hidden');
    loadingIcon?.classList.remove('hidden');

    try {
      const filename = button.dataset.cvPdfFilename;
      if (!filename) {
        throw new Error('CV PDF filename is missing from the page.');
      }

      const response = await fetch('/cv.pdf');
      if (!response.ok) {
        throw new Error(`CV PDF request failed with status ${response.status}.`);
      }
      if (!response.headers.get('content-type')?.includes('application/pdf')) {
        throw new Error('CV PDF response has an unexpected content type.');
      }

      const pdf = await response.blob();
      if (pdf.size === 0) {
        throw new Error('CV PDF response is empty.');
      }

      const url = URL.createObjectURL(pdf);
      const download = document.createElement('a');
      download.href = url;
      download.download = filename;
      download.hidden = true;
      document.body.append(download);
      download.click();
      download.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      label.textContent = 'PDF downloaded';
    } catch (error) {
      console.error('CV PDF download failed:', error);
      label.textContent = 'Try download again';
    } finally {
      button.disabled = false;
      downloadIcon?.classList.remove('hidden');
      loadingIcon?.classList.add('hidden');
    }
  });
</script>
