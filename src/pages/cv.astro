---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<Layout title="CV — Thomas Mohr" description="Editable curriculum vitae for Thomas Mohr.">
  <SiteHeader cvHref="/" cvLabel="Back to portfolio" />

  <main class="shell pb-20 pt-[125px] md:pb-24 md:pt-[150px]">
    <div class="mb-10 flex flex-col border-b border-line pb-10 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Curriculum vitae / 2026</p>
        <h1 class="m-0 text-[clamp(46px,7vw,90px)] leading-[0.9] tracking-[-0.08em]">
          Thomas <em class="font-serif font-normal not-italic">Mohr.</em>
        </h1>
      </div>
      <div class="mt-8 flex items-center gap-[10px] md:mt-0">
        <button
          id="reset-cv"
          type="button"
          class="border border-ink px-[14px] py-[11px] font-mono text-[11px] hover:bg-ink hover:text-paper"
          >Reset</button
        >
        <button
          id="print-cv"
          type="button"
          class="border border-ink px-[14px] py-[11px] font-mono text-[11px] hover:bg-ink hover:text-paper"
          >Print / save PDF</button
        >
        <a
          href="/files/CV.pdf"
          download
          class="border border-ink px-[14px] py-[11px] font-mono text-[11px] hover:bg-ink hover:text-paper"
          >Original PDF ↗</a
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_2fr] md:gap-[100px]">
      <aside class="text-sm">
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Contact</h2>
          <p class="editable rounded text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="contact">
            Marburg, Germany<br />ThomasMohr1990@gmail.com<br />github.com/Thames1990
          </p>
        </section>
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Focus</h2>
          <ul
            class="editable list-none rounded p-0 text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent [&>li]:my-1.5"
            contenteditable="true"
            data-cv="focus"
          >
            <li>Software architecture</li>
            <li>Web &amp; backend development</li>
            <li>Android development</li>
            <li>Machine learning</li>
            <li>Complex event processing</li>
          </ul>
        </section>
        <section class="pb-10">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Tools</h2>
          <p class="editable rounded text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="tools">
            Kotlin · Java · JavaScript<br />TypeScript · Astro · Tailwind<br />HTML · CSS · Git<br />JetBrains IDEs · Android
          </p>
        </section>
        <p class="mt-9 bg-[#e2dfd6] p-[15px] font-mono text-[10px] leading-relaxed text-muted">
          This page is editable. Click any text marked with a subtle focus state to update it. Changes are saved in
          this browser only. Use "Print / save PDF" when you're ready to export.
        </p>
      </aside>

      <div>
        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Profile</h2>
          <p class="editable rounded text-sm text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="profile">
            Enthusiastic software developer with a bachelor's degree in Computer Science. I enjoy turning complex
            problems into dependable, understandable products — and improving them through documentation, testing
            and iteration.
          </p>
        </section>

        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Experience</h2>
          <div class="mb-9 grid grid-cols-1 gap-1 md:grid-cols-[145px_1fr] md:gap-[25px]">
            <div class="editable rounded font-mono text-[11px] uppercase text-accent focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-date-1">
              Current
            </div>
            <div>
              <h3 class="editable m-0 rounded text-2xl tracking-[-0.04em] focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-title-1">
                Software Developer
              </h3>
              <p class="editable rounded text-sm text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-copy-1">
                Intelligent Data Analytics · Marburg, Germany<br />Building software and solving data-driven problems
                as part of a collaborative engineering team.
              </p>
            </div>
          </div>
          <div class="mb-9 grid grid-cols-1 gap-1 md:grid-cols-[145px_1fr] md:gap-[25px]">
            <div class="editable rounded font-mono text-[11px] uppercase text-accent focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-date-2">
              Add dates
            </div>
            <div>
              <h3 class="editable m-0 rounded text-2xl tracking-[-0.04em] focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-title-2">
                Previous experience
              </h3>
              <p class="editable rounded text-sm text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="experience-copy-2">
                Add a role, company and short description here.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-14">
          <h2 class="mb-[18px] border-b border-line pb-3 font-mono text-[11px] uppercase tracking-[0.1em]">Education</h2>
          <div class="grid grid-cols-1 gap-1 md:grid-cols-[145px_1fr] md:gap-[25px]">
            <div class="editable rounded font-mono text-[11px] uppercase text-accent focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="education-date">
              Completed
            </div>
            <div>
              <h3 class="editable m-0 rounded text-2xl tracking-[-0.04em] focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="education-title">
                Bachelor of Computer Science
              </h3>
              <p class="editable rounded text-sm text-muted focus:bg-white focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-accent" contenteditable="true" data-cv="education-copy">
                A foundation in software engineering, algorithms and systems thinking.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <SiteFooter showPortfolioLink />
</Layout>

<style>
  @media print {
    header,
    #reset-cv,
    #print-cv,
    footer {
      display: none !important;
    }
  }
</style>

<script>
  const STORAGE_PREFIX = 'thomas-cv-';
  const editableEls = document.querySelectorAll<HTMLElement>('[data-cv]');

  editableEls.forEach((item) => {
    const key = item.dataset.cv;
    if (!key) return;

    const saved = localStorage.getItem(STORAGE_PREFIX + key);
    if (saved !== null) item.innerHTML = saved;

    item.addEventListener('input', () => {
      localStorage.setItem(STORAGE_PREFIX + key, item.innerHTML);
    });
  });

  document.getElementById('print-cv')?.addEventListener('click', () => {
    window.print();
  });

  document.getElementById('reset-cv')?.addEventListener('click', () => {
    if (window.confirm('Reset your local edits to the starter CV?')) {
      editableEls.forEach((item) => {
        const key = item.dataset.cv;
        if (key) localStorage.removeItem(STORAGE_PREFIX + key);
      });
      window.location.reload();
    }
  });
</script>
