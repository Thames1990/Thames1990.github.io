---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { FieldNotes } from '@/components/FieldNotes';
import { CaseStudyCard } from '@/components/CaseStudyCard';
import { buttonVariants } from '@/components/ui/button';
import { caseStudies } from '@/data/portfolio';
import { cv } from '@/data/cv';

const career = cv.experience.map((role) => ({
  date: role.date,
  title: role.title,
  company: role.company,
  summary: role.summary,
}));

const principles = [
  {
    title: 'Make the tricky bits clear',
    text: 'A lot of software work starts as a knot of wishes, constraints, and unanswered questions. I like untangling that knot with the people involved.',
  },
  {
    title: 'Stay close to the work',
    text: 'I enjoy planning and architecture, but I also like opening the IDE, inspecting the pipeline, testing the release, and helping with whatever is blocking the team.',
  },
  {
    title: 'Think past the merge button',
    text: 'The interesting part often begins after the code is merged. Deployment, support, observability, security, and helping users through change all count.',
  },
];

---

<Layout
  title="Thomas Mohr — Technical Project Lead & Engineering Lead"
  description="Thomas Mohr leads distributed engineering teams and delivers complex data, platform, and product initiatives from architecture through operation."
>
  <SiteHeader />

  <main id="main" tabindex="-1">
    <section
      class="shell grid gap-10 py-12 md:grid-cols-[1.45fr_0.55fr] md:items-center md:gap-12 md:py-16"
      id="top"
    >
      <div>
        <h1 class="display-title max-w-[920px]" data-reveal>
          I help teams make<br /><em class="tracking-[-0.02em]">difficult software feel manageable.</em>
        </h1>
        <p class="my-7 max-w-[610px] text-[17px] leading-relaxed text-muted-foreground md:text-lg md:leading-7" data-reveal>
          I'm Thomas, a Technical Project Lead and hands-on engineer in {cv.location}. I ask a lot of questions,
          enjoy making sense of complicated systems, and help teams turn good intentions into software that
          actually works.
        </p>
        <div class="flex flex-wrap items-center gap-6" data-reveal>
          <a
            class={buttonVariants({ size: 'lg' })}
            data-magnetic
            data-magnetic-strength="14"
            href={`mailto:${cv.email}?subject=Technical leadership opportunity`}
          >
            Email me about a role <span aria-hidden="true">↗</span>
          </a>
          <a class={buttonVariants({ variant: 'outline', size: 'lg' })} href="#work">
            View selected work <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="mt-5 inline-flex items-center gap-2.5 text-sm text-muted-foreground">
          <span class="inline-block h-2 w-2 rounded-full bg-good"></span>
          {cv.availability}
        </p>
      </div>

      <aside
        data-tilt
        data-tilt-strength="5"
        data-reveal
        aria-label="A few useful numbers"
      >
        <div data-tilt-child><FieldNotes /></div>
      </aside>
    </section>

    <section class="border-y bg-secondary/50 py-12 md:py-16" id="work">
      <div class="shell">
        <div class="mb-8 grid gap-5 md:grid-cols-[0.8fr_1.2fr] md:gap-12" data-reveal>
          <h2 class="section-title">Selected work.</h2>
          <p class="m-0 max-w-[620px] self-end text-[17px] leading-relaxed text-muted-foreground md:pb-1 md:text-lg md:leading-7">
            Three projects where I helped teams turn complicated systems into dependable products — from first
            decisions through day-to-day operation.
          </p>
        </div>

        <div class="space-y-8">
          {caseStudies.map((study) => (
            <article data-reveal><CaseStudyCard study={study} client:load /></article>
          ))}
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-secondary py-20 text-secondary-foreground md:py-28" id="about">
      <div class="shell relative z-1">
        <div class="grid gap-10 md:grid-cols-[1.4fr_0.8fr]" data-reveal>
          <h2 class="section-title">
            Set direction.<br /><em class="tracking-[-0.02em]">Stay involved.</em>
          </h2>
          <p class="max-w-[320px] text-sm leading-relaxed text-muted-foreground md:self-end md:pb-1">
            I'm happiest somewhere between the roadmap and the runtime — helping people agree on where we're
            going, then being useful when the route gets bumpy.
          </p>
        </div>

        <div class="mt-12 grid border-y border-border md:grid-cols-3 md:divide-x md:divide-border">
          {principles.map((principle) => (
            <article
              class="border-b border-border py-8 last:border-0 md:border-0 md:px-8 md:first:pl-0 md:last:pr-0"
              data-reveal
            >
              <h3 class="mb-3 text-xl font-semibold tracking-tight">{principle.title}</h3>
              <p class="m-0 text-sm leading-relaxed text-muted-foreground">{principle.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="shell py-16 md:py-24" id="experience">
      <div class="grid gap-12 md:grid-cols-[0.8fr_2.2fr]">
        <h2 class="section-title md:sticky md:top-24 md:self-start" data-reveal>
          Still learning.<br />Just with <em class="tracking-[-0.02em]">bigger problems.</em>
        </h2>
        <div class="border-t border-line">
          {career.map((role) => (
            <article class="grid gap-4 border-b border-line py-8 md:grid-cols-[120px_1fr] md:gap-8 md:py-10" data-reveal>
              <div class="flex justify-between md:block">
                <span class="text-sm font-medium text-brand">{role.date}</span>
              </div>
              <div>
                <h3 class="m-0 text-xl font-semibold tracking-[-0.03em]">{role.title}</h3>
                <p class="mb-4 mt-1 text-sm font-semibold">{role.company}</p>
                <p class="m-0 max-w-[650px] text-sm leading-relaxed text-muted-foreground">{role.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="relative overflow-hidden border-t border-border bg-secondary py-16 text-secondary-foreground md:py-24"
      id="contact"
    >
      <div class="shell relative z-1" data-reveal>
        <h2 class="section-title max-w-3xl">
          Let's talk about the <em>work.</em>
        </h2>
        <p class="my-6 max-w-[500px] text-sm leading-relaxed text-muted-foreground">
          I'm looking for a permanent Technical Project Lead or Engineering Lead role. If you have an interesting
          problem, a thoughtful team, and room for someone who likes both people and systems, I'd be glad to hear
          from you.
        </p>
        <div class="flex flex-wrap gap-5">
          <a
            class={buttonVariants({ size: 'lg' })}
            data-magnetic
            data-magnetic-strength="14"
            href={`mailto:${cv.email}?subject=Technical leadership opportunity`}
          >
            Email me about a role <span aria-hidden="true">↗</span>
          </a>
          <a class={buttonVariants({ variant: 'outline', size: 'lg' })} data-magnetic data-magnetic-strength="14" href={cv.linkedin} target="_blank" rel="noopener">
            Connect on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div
          class="mt-12 flex flex-col justify-between gap-3 border-t border-border pt-5 text-xs md:flex-row"
        >
          <span>{cv.email}</span><span>{cv.location}</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
