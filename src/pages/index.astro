---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { FieldNotes } from '@/components/FieldNotes';
import { CaseStudyCard } from '@/components/CaseStudyCard';
import { caseStudies } from '@/data/portfolio';
import { cv } from '@/data/cv';

const career = cv.experience.map((role) => ({
  date: role.date,
  title: role.title,
  company: role.company,
  summary: role.summary,
}));

const principles = [
  {
    title: 'Make the tricky bits clear',
    text: 'A lot of software work starts as a knot of wishes, constraints, and unanswered questions. I like untangling that knot with the people involved.',
  },
  {
    title: 'Stay close to the work',
    text: 'I enjoy planning and architecture, but I also like opening the IDE, inspecting the pipeline, testing the release, and helping with whatever is blocking the team.',
  },
  {
    title: 'Think past the merge button',
    text: 'The interesting part often begins after the code is merged. Deployment, support, observability, security, and helping users through change all count.',
  },
];
---

<Layout
  title="Thomas Mohr — Technical Project Lead & Engineering Lead"
  description="Thomas Mohr leads distributed engineering teams and delivers complex data, platform, and product initiatives from architecture through operation."
>
  <SiteHeader />

  <main id="main" tabindex="-1">
    <!--
      THESIS: A signal bench makes Thomas's real project evidence the portfolio; it refuses the generic bio-over-card-stack opening.
      OWN-WORLD: Ash-white instrument stock, blackened chassis panels, signal-orange active marks, and chartreuse state labels; square controls and ruled readouts.
      STORY: Hiring teams see a leader who stays hands-on, verify that through three shipped-project readouts, then follow either the concise route or full CV.
      FIRST VIEWPORT: A slim wordmark header sits above an ink-dark split panel: oversized role-led statement and email/CV actions at left, availability and three outcome readouts at right.
      FORM: Signal Bench, fifth grounded direction assigned by seed 473b43f2; portfolio evidence follows a measured hang, with meaningful short gaps between projects and larger chapter rests; surface seed 6e02ef92.
    -->
    <section class="bench-intro" id="top">
      <div class="shell bench-intro__inner">
        <div class="bench-intro__copy">
          <h1 class="display-title">
            Leading the work.<br /><em>Shipping the system.</em>
          </h1>
          <p class="bench-intro__summary">
            I'm Thomas Mohr: a Technical Project Lead and hands-on engineer who takes complex software from planning through production. Currently available for a permanent role.
          </p>
          <div class="bench-actions">
            <a class="bench-button bench-button--signal" href={`mailto:${cv.email}?subject=Technical leadership opportunity`}>
              Talk about a role <span aria-hidden="true">↗</span>
            </a>
            <a class="bench-button bench-button--line" href="/cv">
              Read my CV <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <aside class="bench-readouts" aria-label="Selected project outcomes">
          <FieldNotes />
        </aside>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <h2 class="section-title">Selected projects</h2>
          <p>I helped teams bring these complex, data-heavy systems into day-to-day use.</p>
        </div>
        <div class="work-list">
          {caseStudies.map((study) => (
            <article class="work-item" id={`project-${study.index}`}><CaseStudyCard study={study} client:load /></article>
          ))}
        </div>
      </div>
    </section>

    <section class="approach-section" id="about">
      <div class="shell">
        <div class="approach-heading" data-reveal>
          <h2 class="section-title">From the roadmap<br />to the runtime.</h2>
          <p>Good leadership doesn't stop at agreeing on a plan. I stay close enough to the system to help the team make it real.</p>
        </div>
        <div class="principle-list">
          {principles.map((principle) => (
            <article class="principle" data-reveal>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="experience-section" id="experience">
      <div class="shell experience-layout">
        <div class="experience-intro" data-reveal>
          <h2 class="section-title">Built across<br />different systems.</h2>
          <p>Data platforms, real-time aviation, customer software, and the infrastructure that keeps them running.</p>
          <a class="text-link" href="/cv">See the complete experience <span aria-hidden="true">↗</span></a>
        </div>
        <div class="career-list">
          {career.map((role) => (
            <article class="career-entry" data-reveal>
              <p class="career-date">{role.date}</p>
              <div>
                <h3>{role.title}</h3>
                <p class="career-company">{role.company}</p>
                <p class="career-summary">{role.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact">
      <div class="shell contact-panel" data-reveal>
        <div>
          <h2 class="section-title">Have a hard problem<br />worth solving?</h2>
          <p>I'm looking for a permanent Technical Project Lead or Engineering Lead role. I prefer on-site work in the Frankfurt region and am open to hybrid arrangements.</p>
        </div>
        <div class="contact-actions">
          <a class="bench-button bench-button--signal" href={`mailto:${cv.email}?subject=Technical leadership opportunity`}>
            Email me <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={cv.linkedin} target="_blank" rel="noopener">
            Find me on LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <span class="contact-detail">{cv.location}</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
