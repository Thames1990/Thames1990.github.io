---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { getEntry } from 'astro:content';

const cvEntry = await getEntry('cv', 'cv');
if (!cvEntry) throw new Error('CV content is required for the portfolio profile');
const cv = cvEntry.data;

const marqueeItems = ['software architecture', 'web & backend', 'machine learning', 'developer experience'];

const projects = [
  {
    label: 'Open source',
    index: '01 / 03',
    title: 'Aardvark',
    description:
      'A public playground for building, testing and sharing ideas with a focus on clean interfaces and useful abstractions.',
    tags: ['Kotlin', 'Architecture', 'Tooling'],
    image: '/img/portfolio/aardvark.png',
    href: 'https://github.com/Thames1990/aardvark',
    featured: true,
  },
  {
    label: 'Experiments',
    index: '02 / 03',
    title: 'Small, sharp tools',
    description: 'Side projects exploring games, interaction and the joy of making something work from scratch.',
    tags: ['Java', 'Web', 'Play'],
    image: '/img/portfolio/game.png',
    href: 'https://github.com/Thames1990',
  },
];
---

<Layout
  title="Thomas Mohr — Software Developer"
  description="Thomas Mohr is a software developer building thoughtful products, resilient systems and useful tools."
>
  <SiteHeader />

  <main id="main">
    <!-- Hero -->
    <section class="shell relative grid min-h-[760px] grid-cols-1 items-center pt-[150px] md:grid-cols-[1.2fr_0.8fr] md:pt-[110px]" id="top">
      <div class="pb-20 pt-0 md:py-[52px]">
        <p class="eyebrow flex items-center">
          <span class="mr-[9px] inline-block h-[7px] w-[7px] rounded-full bg-[#78aa70] shadow-[0_0_0_5px_#dce7d8]"></span>
          {cv.availability}
        </p>
        <h1 class="max-w-[800px] text-[clamp(50px,8vw,106px)] font-extrabold leading-[0.97] tracking-[-0.08em]">
          Building software<br /><em class="font-serif font-normal not-italic tracking-[-0.06em]">that holds up.</em>
        </h1>
        <p class="my-9 max-w-[490px] text-lg text-[#565650]">
          I'm Thomas, a technical project lead and engineer in {cv.location}. I turn complex ideas into clear, dependable products — from
          the first sketch to the last deploy.
        </p>
        <div class="flex items-center gap-7">
          <a class="btn btn-primary" href="#work">See my work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/cv">View CV <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="mt-[70px] flex flex-col items-start justify-center self-stretch md:mt-0 md:items-end" aria-label="Introduction">
        <div class="relative aspect-[4/5] w-[70%] max-w-[300px] overflow-hidden bg-blue after:absolute after:inset-3 after:border after:border-ink/25 md:w-full md:max-w-[330px]">
          <img class="h-full w-full object-cover opacity-80 grayscale mix-blend-multiply" src="/img/profile.png" alt="Portrait of Thomas Mohr" />
          <span class="absolute bottom-[21px] left-[21px] z-[1] font-mono text-[10px] uppercase leading-relaxed text-ink"
            >Frankfurt<br />DE / 50.11&deg; N</span
          >
        </div>
        <p class="mt-[18px] w-full max-w-[330px] font-mono text-xs uppercase leading-relaxed text-muted">
          Curious by default.<br />Precise by design.
        </p>
      </div>
      <div class="absolute bottom-8 left-0 hidden items-center gap-[18px] font-mono text-[10px] uppercase text-muted md:flex">
        <span>Scroll to explore</span><i class="block h-px w-14 bg-muted"></i>
      </div>
    </section>

    <!-- Marquee -->
    <section class="overflow-hidden whitespace-nowrap bg-ink py-[15px] text-paper" aria-label="Areas of expertise">
      <div class="flex w-max animate-marquee items-center gap-[27px] font-mono text-xs uppercase">
        {
          [...marqueeItems, ...marqueeItems].map((item) => (
            <>
              <span>{item}</span>
              <b class="text-lg text-accent">✳</b>
            </>
          ))
        }
      </div>
    </section>

    <!-- Selected work -->
    <section class="shell py-[90px] md:py-[145px]" id="work">
      <div class="mb-[50px] block md:mb-[76px] md:grid md:grid-cols-[1fr_1.5fr_1fr] md:items-start">
        <p class="eyebrow md:pt-[10px]">01 / Selected work</p>
        <h2 class="m-0 text-[clamp(40px,5vw,66px)] leading-[0.98] tracking-[-0.075em]">
          Things I've<br /><em class="font-serif font-normal not-italic tracking-[-0.06em]">helped make.</em>
        </h2>
        <p class="mt-7 max-w-[250px] text-sm text-muted md:ml-auto md:mt-2">
          A small selection of open-source work and experiments. The best projects are where a hard technical problem
          meets a simple human outcome.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-[55px] md:grid-cols-[1.2fr_0.8fr] md:gap-x-[22px] md:gap-y-[50px]">
        {
          projects.map((project) => (
            <article>
              <a
                href={project.href}
                target="_blank"
                rel="noopener"
                class="group relative block aspect-[1.45] overflow-hidden bg-[#d7c6aa]"
              >
                <img
                  class="h-full w-full object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-[1.06]"
                  src={project.image}
                  alt={`${project.title} logo`}
                />
                <span class="absolute right-[18px] top-[18px] grid h-[38px] w-[38px] place-items-center rounded-full bg-paper text-xl">
                  ↗
                </span>
              </a>
              <div class="mt-[18px] flex justify-between font-mono text-[10px] uppercase text-muted">
                <span>{project.label}</span>
                <span>{project.index}</span>
              </div>
              <h3 class="mb-2 mt-[10px] text-2xl tracking-[-0.04em]">{project.title}</h3>
              <p class="max-w-[470px] text-sm text-muted">{project.description}</p>
              <div class="mt-5 flex flex-wrap gap-[7px]">
                {project.tags.map((tag) => (
                  <span class="rounded-full border border-line px-[9px] py-[5px] font-mono text-[10px] text-muted">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }

        <article class="md:col-span-2 md:grid md:grid-cols-2 md:gap-x-7">
          <div class="min-h-[250px] bg-[#1a1d21] p-[22px_22px_22px_22px] font-mono text-[13px] leading-loose text-[#d2d6d8]" aria-label="A code sample">
            <div class="flex items-center gap-[5px] border-b border-[#363b40] pb-3 text-[10px] text-[#6d7379]">
              <i class="block h-[7px] w-[7px] rounded-full bg-[#dd6d57]"></i>
              <i class="block h-[7px] w-[7px] rounded-full bg-[#d4af5d]"></i>
              <i class="block h-[7px] w-[7px] rounded-full bg-[#7eab75]"></i>
              <span class="ml-auto">thomas.dev</span>
            </div>
            <pre class="my-[22px]"><code><span class="text-[#83b9d4]">const</span> <span class="text-[#e1c57b]">idea</span> = <span class="text-[#df8caa]">listen</span>();

<span class="text-[#83b9d4]">while</span> (idea.<span class="text-[#a9ca92]">canImprove</span>()) {'{'}
  idea.<span class="text-[#a9ca92]">ship</span>();
{'}'}</code></pre>
          </div>
          <div>
            <div class="mt-[18px] flex justify-between font-mono text-[10px] uppercase text-muted md:mt-0">
              <span>How I work</span>
              <span>03 / 03</span>
            </div>
            <h3 class="mb-2 mt-[10px] text-2xl tracking-[-0.04em]">Learn. Build. Refine.</h3>
            <p class="max-w-[470px] text-sm text-muted">
              Technology changes quickly. A good process keeps the important things — clarity, empathy and craft —
              constant.
            </p>
            <div class="mt-5 flex flex-wrap gap-[7px]">
              {['Curiosity', 'Testing', 'Documentation'].map((tag) => (
                <span class="rounded-full border border-line px-[9px] py-[5px] font-mono text-[10px] text-muted">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      </div>

      <a
        class="mt-[52px] inline-block border-b border-ink pb-[5px] text-xs font-extrabold"
        href="https://github.com/Thames1990"
        target="_blank"
        rel="noopener"
        >Explore all repositories <span aria-hidden="true">↗</span></a
      >
    </section>

    <!-- About -->
    <section class="bg-blue py-[90px] md:py-[145px]" id="about">
      <div class="shell grid grid-cols-1 gap-[45px] md:grid-cols-2 md:gap-20">
        <div>
          <p class="eyebrow">02 / About me</p>
          <h2 class="m-0 text-[clamp(40px,5vw,66px)] leading-[0.98] tracking-[-0.075em]">
            The human<br /><em class="font-serif font-normal not-italic tracking-[-0.06em]">behind the code.</em>
          </h2>
        </div>
        <div class="pt-[10px]">
          <p class="max-w-[470px] text-2xl leading-[1.35] tracking-[-0.03em] text-ink">
            I'm an enthusiastic software developer with a bachelor's degree in Computer Science and a soft spot for
            difficult problems.
          </p>
          <p class="mt-4 max-w-[470px] text-[15px] text-[#4f5c5c]">
            My work spans Kotlin and Java, Android, frontend and backend development, machine learning, complex event
            processing and mesh networks. I care about the whole system: the architecture, the documentation, the
            tests and the experience of the person using it.
          </p>
          <div class="my-[45px] flex flex-wrap gap-[22px] md:my-[55px] md:gap-[45px]">
            <div class="flex items-start gap-[9px]">
              <strong class="font-mono text-2xl">&infin;</strong>
              <span class="font-mono text-[10px] uppercase leading-snug text-[#4f5c5c]">Things left<br />to learn</span>
            </div>
            <div class="flex items-start gap-[9px]">
              <strong class="font-mono text-2xl">01</strong>
              <span class="font-mono text-[10px] uppercase leading-snug text-[#4f5c5c]">Good idea<br />at a time</span>
            </div>
            <div class="flex items-start gap-[9px]">
              <strong class="font-mono text-2xl">DE</strong>
              <span class="font-mono text-[10px] uppercase leading-snug text-[#4f5c5c]">Based in<br />Frankfurt</span>
            </div>
          </div>
          <a class="text-link" href="/cv">Read my full CV <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="shell py-[70px] md:py-[100px]" id="contact">
      <div class="relative overflow-hidden bg-accent p-8 text-ink md:p-[70px_8%]">
        <span class="pointer-events-none absolute right-[7%] top-[14%] text-[190px] leading-none opacity-[0.14]" aria-hidden="true">✳</span>
        <p class="eyebrow relative z-[1]">03 / Get in touch</p>
        <h2 class="relative z-[1] m-0 text-[clamp(42px,6vw,78px)] leading-[0.95] tracking-[-0.08em]">
          Have a problem<br /><em class="font-serif font-normal not-italic tracking-[-0.06em]">worth solving?</em>
        </h2>
        <p class="relative z-[1] my-7 max-w-[340px] text-sm text-[#633b31]">
          Whether you're building something new or making an existing system better, I'd love to hear what you're
          working on.
        </p>
        <a class="btn btn-light" href={`mailto:${cv.email}`}>Start a conversation <span aria-hidden="true">↗</span></a>
        <div class="mt-[55px] flex flex-col justify-between gap-4 border-t border-ink/25 pt-[18px] font-mono text-[10px] uppercase md:flex-row">
          <span>{cv.email}</span>
          <span>{cv.location}</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
